#!/usr/bin/env bash
# Shim so anything invoking a bare `browser-harness` runs THIS checkout rather
# than whatever is installed globally. Used two ways: prepend this directory to
# PATH, or symlink it from ~/.local/bin.
#
# BASH_SOURCE is the SYMLINK's path when invoked through one, so it has to be
# resolved before deriving the repo root — otherwise this looks for the launcher
# beside the symlink and silently falls through to a globally installed
# browser_harness module (which is how a stale 0.1.4 kept winning).
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$DIR/$SRC" ;; esac
done
HERE="$(cd -P "$(dirname "$SRC")" && pwd)"
exec "$HERE/../../browser-harness" "$@"
