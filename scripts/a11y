#!/usr/bin/env bash
# Start, check, and stop the accessibility stack.
#
#   scripts/a11y up       start everything, verify it, lay the windows out
#   scripts/a11y status   what is running, and what is wrong
#   scripts/a11y down     stop everything this script starts
#
# Every failure here has bitten us at least once. The point of the script is
# that each one now reports what to do rather than surfacing three layers down
# as "That didn't work".
set -uo pipefail

A11Y="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TOOLKIT="${AA_TOOLKIT_DIR:-$A11Y/../AI-for-Accessibility-Toolkit-Draft}"
AGENT="${AA_AGENT_DIR:-$A11Y/../browser-harness/extension-service}"
CONTROLLER_URL="${AA_CONTROLLER_URL:-http://127.0.0.1:4000/controller}"
LOGS="${AA_LOG_DIR:-/tmp}"

# A dedicated automation Chrome, launched with the debugging port rather than
# toggled on afterwards. This is what avoids the M144 "Allow remote debugging?"
# prompt and the M136 default-profile lockdown — the prompt that has been the
# single largest source of mystery failures. --guest keeps it signed out, so a
# participant logs into whatever they need themselves and nothing of the
# operator's is in the profile.
#
# NOT --guest: guest mode refuses Target.createTarget outright ("Failed to open
# a new tab"), so no tab can be opened over CDP and the harness cannot work at
# all. A dedicated profile directory gives the same isolation — it starts signed
# out, so the person logs into whatever they need — and unlike guest it keeps
# that login for the rest of the session instead of discarding it on close.
CHROME_PORT="${AA_CHROME_PORT:-9222}"
CHROME_DIR="${AA_CHROME_PROFILE:-$HOME/.a11y-chrome}"
CHROME_BIN="${AA_CHROME_BIN:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
export BU_CDP_URL="http://127.0.0.1:$CHROME_PORT"

ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; }
info() { printf '    %s\n' "$1"; }

port_pid() { lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null | head -1; }

# macOS has no timeout(1). Every browser-harness call can block for the length
# of Chrome's permission handshake (~45s), so nothing here runs unbounded — a
# waiting prompt should report itself, not hang the script.
bounded() {  # bounded <seconds> <cmd...>
  local secs="$1"; shift
  # <&0 explicitly: bash points a background job's stdin at /dev/null, which
  # would silently swallow the heredoc these calls are driven by.
  "$@" <&0 & local pid=$!
  local i=0
  while kill -0 "$pid" 2>/dev/null; do
    [ "$i" -ge "$secs" ] && { kill -9 "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; return 124; }
    sleep 1; i=$((i+1))
  done
  wait "$pid"
}
port_up()  { [ -n "$(port_pid "$1")" ]; }

wait_for() {  # wait_for <port> <seconds>
  local i=0
  while [ "$i" -lt "$2" ]; do port_up "$1" && return 0; sleep 1; i=$((i+1)); done
  return 1
}

# ── preflight ───────────────────────────────────────────────────────────────
preflight() {
  local fail=0
  [ -d "$TOOLKIT/server" ] && ok "toolkit checkout: $TOOLKIT" || {
    bad "toolkit not found at $TOOLKIT"; info "set AA_TOOLKIT_DIR"; fail=1; }
  [ -x "$AGENT/run.sh" ] && ok "agent service: $AGENT" || {
    bad "agent service not found at $AGENT"; info "set AA_AGENT_DIR"; fail=1; }
  [ -f "$A11Y/src/browser_harness/a11y/bundle.js" ] && ok "adapter bundle built" || {
    bad "adapter bundle missing"; info "run: python3 scripts/build_a11y.py"; fail=1; }

  # The agent needs a key, and fails only when a task actually runs otherwise.
  if grep -qs '^GEMINI_API_KEY=.' "$AGENT/../.env"; then ok "GEMINI_API_KEY present"
  else bad "GEMINI_API_KEY missing"; info "add it to $AGENT/../.env — tasks will fail without it"; fail=1; fi

  # A bare `browser-harness` must be THIS checkout: a stale global silently
  # loses the a11y helpers and the IPC stream-limit fix.
  local which_bh; which_bh="$(command -v browser-harness || true)"
  if [ -z "$which_bh" ]; then
    bad "no browser-harness on PATH"; info "ln -sfn $A11Y/scripts/agent-path/browser-harness ~/.local/bin/browser-harness"; fail=1
  else
    # Resolve the symlink and compare paths. Running a script to introspect the
    # helpers would start a daemon and need Chrome, which conflates "is this the
    # right binary" with "is the browser reachable" — and false-failed when it
    # was only the browser that was down.
    local resolved
    resolved="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$which_bh" 2>/dev/null)"
    if [ "$resolved" = "$A11Y/scripts/agent-path/browser-harness" ]; then
      ok "browser-harness on PATH is this checkout"
    else
      bad "browser-harness on PATH is not this checkout"
      info "it resolves to: ${resolved:-$which_bh}"
      info "ln -sfn $A11Y/scripts/agent-path/browser-harness ~/.local/bin/browser-harness"; fail=1
    fi
  fi
  return $fail
}

# ── chrome ──────────────────────────────────────────────────────────────────
chrome_endpoint_up() { curl -s -m 2 "$BU_CDP_URL/json/version" >/dev/null 2>&1; }

start_chrome() {
  if chrome_endpoint_up; then ok "automation Chrome already on :$CHROME_PORT"; return 0; fi
  [ -x "$CHROME_BIN" ] || { bad "Chrome not found at $CHROME_BIN"; info "set AA_CHROME_BIN"; return 1; }

  mkdir -p "$CHROME_DIR"
  ( "$CHROME_BIN" \
      --remote-debugging-port="$CHROME_PORT" \
      --user-data-dir="$CHROME_DIR" \
      --no-first-run --no-default-browser-check \
      --remote-allow-origins="$BU_CDP_URL" \
      about:blank > "$LOGS/chrome.log" 2>&1 < /dev/null & )

  local i=0
  while [ "$i" -lt 25 ]; do
    chrome_endpoint_up && { ok "automation Chrome launched on :$CHROME_PORT (dedicated signed-out profile)"; return 0; }
    sleep 1; i=$((i+1))
  done
  bad "Chrome did not open a debugging port on :$CHROME_PORT"
  info "see $LOGS/chrome.log"
  return 1
}

restart_daemon() {
  # The daemon reads BU_CDP_URL once, at start. One left over from a previous
  # run is still attached to whatever Chrome it found then.
  pkill -f browser_harness.daemon >/dev/null 2>&1 && sleep 2
  local out rc
  out="$(cd "$A11Y" && bounded 30 ./browser-harness <<<'print(len(list_tabs(include_chrome=True)))' 2>&1)"; rc=$?
  if [ "$rc" -eq 124 ]; then bad "harness could not reach Chrome within 30s"; info "see $LOGS/chrome.log"; return 1; fi
  case "$out" in
    *[0-9]*) ok "harness attached to the automation Chrome"; return 0 ;;
    *) bad "harness could not attach: $(printf '%s' "$out" | tail -1 | cut -c1-70)"; return 1 ;;
  esac
}

# ── services ────────────────────────────────────────────────────────────────
start_one() {  # start_one <name> <port> <dir> <cmd...>
  local name="$1" port="$2" dir="$3"; shift 3
  if port_up "$port"; then ok "$name already up on :$port"; return 0; fi
  ( cd "$dir" && nohup "$@" > "$LOGS/$name.log" 2>&1 < /dev/null & )
  if wait_for "$port" 25; then ok "$name started on :$port"
  else bad "$name did not come up on :$port"; info "see $LOGS/$name.log"; return 1; fi
}

up() {
  echo "preflight"
  preflight || { echo; bad "fix the above and re-run"; return 1; }

  echo; echo "chrome"
  start_chrome   || return 1
  restart_daemon || return 1

  echo; echo "services"
  start_one librarian  8080 "$TOOLKIT" node server/index.js     || return 1
  start_one onboarding 4000 "$TOOLKIT" node onboarding/server.js || return 1
  # BU_CDP_URL is exported, so the agent's own browser-harness calls attach to
  # the same automation Chrome rather than hunting for a default profile.
  start_one agent      8787 "$AGENT"   ./run.sh                 || return 1

  # The receiver is restarted every time: it pins a tab at startup, and a stale
  # one silently keeps serving an old target (and old code — a second copy just
  # exits with "address already in use" while the old one answers).
  if port_up 9333; then kill "$(port_pid 9333)" 2>/dev/null; sleep 2; fi

  echo; echo "layout"
  local ids
  ids="$(cd "$A11Y" && bounded 40 ./browser-harness <<PY 2>/dev/null | tail -1
import json
print(json.dumps(a11y_layout(controller_url="$CONTROLLER_URL")))
PY
)"
  local driven controller
  driven="$(printf '%s' "$ids" | python3 -c 'import json,sys; print(json.load(sys.stdin)["driven"])' 2>/dev/null)"
  controller="$(printf '%s' "$ids" | python3 -c 'import json,sys; print(json.load(sys.stdin)["controller"])' 2>/dev/null)"
  if [ -n "$driven" ]; then ok "Controller and driven page tiled side by side"
  else bad "could not lay out the windows"; info "continuing without a pinned target"; fi

  ( cd "$A11Y" && nohup ./browser-harness control --port 9333 ${driven:+--target "$driven"} \
      > "$LOGS/control.log" 2>&1 < /dev/null & )
  if wait_for 9333 20; then ok "receiver started on :9333${driven:+ (pinned)}"
  else bad "receiver did not start"; info "see $LOGS/control.log"; return 1; fi

  # Connect the Controller for them. Only now: the button opens a WebSocket, so
  # clicking it before the receiver is listening fails silently and leaves the
  # person looking at a Controller that quietly drives nothing.
  if [ -n "$controller" ]; then
    local note
    note="$(cd "$A11Y" && bounded 30 ./browser-harness <<CONNECT 2>/dev/null | tail -1
import time
js("document.getElementById('connect-local')?.click(); return 1", target_id="$controller")
n = ""
for _ in range(20):
    time.sleep(0.25)
    n = js("const e=document.getElementById('drive-note'); return e ? e.textContent.trim() : ''", target_id="$controller")
    if "remote receiver" in n:
        break
print(n)
CONNECT
)"
    case "$note" in
      *"remote receiver"*) ok "Controller connected to the harness" ;;
      *) bad "Controller did not connect automatically"
         info "click \"Connect to local harness\" in the Controller" ;;
    esac
  fi

  echo; status
  echo; info "Ready — type into the Controller on the left."
}

status() {
  echo "status"
  local names=(librarian onboarding agent receiver) ports=(8080 4000 8787 9333)
  for i in "${!ports[@]}"; do
    if port_up "${ports[$i]}"; then ok "${names[$i]} :${ports[$i]}"
    else bad "${names[$i]} :${ports[$i]} down"; fi
  done
  chrome_endpoint_up && ok "automation Chrome :$CHROME_PORT" || bad "automation Chrome :$CHROME_PORT down"
  pgrep -f browser_harness.daemon >/dev/null 2>&1 && ok "harness daemon" || bad "harness daemon down"
  curl -s -m 3 http://localhost:8080/healthz >/dev/null 2>&1 && ok "librarian answering" || bad "librarian not answering"
  curl -s -m 3 http://127.0.0.1:8787/health >/dev/null 2>&1 && ok "agent answering"     || bad "agent not answering"
  # A token minted against a different DATA_DIR looks like a working service.
  if [ -f "$A11Y/.env" ]; then
    local tok; tok="$(sed -n 's/^AI4A11Y_TOKEN=//p' "$A11Y/.env" | head -1)"
    if [ -n "$tok" ] && curl -s -m 3 -H "Authorization: Bearer $tok" \
         http://localhost:8080/v1/whoami | grep -q '"uid"'; then ok "profile token valid"
    else bad "profile token invalid or missing"
         info "mint one: POST /admin/tokens, then set AI4A11Y_TOKEN in .env"; fi
  fi
}

down() {
  echo "stopping"
  for p in 9333 8787 4000 8080; do
    local pid; pid="$(port_pid "$p")"
    [ -n "$pid" ] && { kill "$pid" 2>/dev/null; ok "stopped :$p"; } || info ":$p already down"
  done
}

case "${1:-up}" in
  up)     up ;;
  status) status ;;
  down)   down ;;
  *) echo "usage: scripts/a11y [up|status|down]" >&2; exit 2 ;;
esac
